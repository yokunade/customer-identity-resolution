# Optional overrides for docker compose. Copy to .env and edit.
# Every value here already has a demo default in docker-compose.yml.

# HMAC secret for match/blocking keys. Generate: python -c "import secrets;print(secrets.token_hex(32))"
# Changing it invalidates every stored key.
KEY_SECRET=

# Comma-separated API keys for the X-API-Key header on /v1 endpoints.
API_KEYS=demo-key

# Tiers that link automatically; matches in the others go to the review queue.
AUTO_LINK_TIERS=exact,strong,probable

# true when served over HTTPS (production); false for the plain-http demo.
REVIEW_COOKIE_SECURE=false

# Demo loader
DEMO_RECORDS=20000
DEMO_PASSWORD=review-demo-2026

# Host ports
API_PORT=8000
DB_PORT=5433

LOG_LEVEL=INFO
